    def outcome_from_arr(arr):
        feitos = int(np.rint(arr[1]))
        sofridos = int(np.rint(arr[0]))
        if feitos == sofridos:
            return 'Empate'
        return 'Vitória do flamengo' if feitos > sofridos else 'Vitória do adversário'

    def outcome_counts_correct(y_pred_arr, y_true_arr):
        # recebe arrays numpy numéricos Nx2
        keys = ['Empate', 'Vitória do flamengo', 'Vitória do adversário']
        correct = {k: 0 for k in keys}
        totals = {k: 0 for k in keys}
        n = len(y_true_arr)
        for i in range(n):
            actual = outcome_from_arr(y_true_arr[i])
            pred = outcome_from_arr(y_pred_arr[i])
            totals[actual] += 1
            if pred == actual:
                correct[actual] += 1
        return correct, totals

