            if xgb_available:
                resultados_finais.append(f'XGBoost - acertos total>=2 (Primeiros {len(y_first)}): {over2_first_xgb}/{len(y_first)}')

            # Imprimir detalhes por rodada para os primeiros N jogos: Real, RF, LR e flags de acerto
            rows_first = []
            for i in range(len(y_first_arr)):
                real_sofr = int(np.rint(y_first_arr[i, 0]))
                real_feit = int(np.rint(y_first_arr[i, 1]))
                rf_sofr = int(np.rint(y_pred_first_rf_arr[i, 0]))
                rf_feit = int(np.rint(y_pred_first_rf_arr[i, 1]))
                lr_sofr = int(np.rint(y_pred_first_lr_arr[i, 0]))
                lr_feit = int(np.rint(y_pred_first_lr_arr[i, 1]))

                # over2
                real_over2 = (real_feit + real_sofr) >= 2
                rf_over2 = (rf_feit + rf_sofr) >= 2
                lr_over2 = (lr_feit + lr_sofr) >= 2

                # outcome
                def outcome(feitos, sofridos):
                    if feitos == sofridos:
                        return 'Empate'
                    return 'Vitória do flamengo' if feitos > sofridos else 'Vitória do adversário'

                real_res = outcome(real_feit, real_sofr)
                rf_res = outcome(rf_feit, rf_sofr)
                lr_res = outcome(lr_feit, lr_sofr)
                xgb_sofr = int(np.rint(y_pred_first_xgb_arr[i, 0])) if xgb_available else None
                xgb_feit = int(np.rint(y_pred_first_xgb_arr[i, 1])) if xgb_available else None
                xgb_over2 = (xgb_feit + xgb_sofr) >= 2 if xgb_available else None
                xgb_res = outcome(xgb_feit, xgb_sofr) if xgb_available else None

