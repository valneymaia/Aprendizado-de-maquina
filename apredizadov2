                    raw_lr = y_pred_first_lr_arr[i]
                    round_lr = np.rint(raw_lr).astype(int)
                    real = y_first_arr[i].astype(int)

                    # recomputar outcomes
                    def outcome_arr(arr):
                        feitos = int(np.rint(arr[1]))
                        sofridos = int(np.rint(arr[0]))
                        if feitos == sofridos:
                            return 'Empate'
                        return 'Vitória do flamengo' if feitos > sofridos else 'Vitória do adversário'

                    rf_out = outcome_arr(raw_rf)
                    lr_out = outcome_arr(raw_lr)
                    real_out = outcome_arr(real)

                    # totals and >=2 flags
                    real_total = int(np.rint(real[0]) + np.rint(real[1]))
                    rf_total = int(np.rint(raw_rf[0]) + np.rint(raw_rf[1]))
